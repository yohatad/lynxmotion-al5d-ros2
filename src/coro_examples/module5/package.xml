<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>module5</name>
  <version>1.0.0</version>
  <description>Cognitive robotics module 5: computer vision examples with OpenCV, camera calibration and simulator camera (ROS 2 Jazzy port)</description>
  <maintainer email="david@vernon.eu">David Vernon</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>coro_common</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>libopencv-dev</depend>
  <depend>libncurses-dev</depend>
  <depend>lynxmotion_al5d_description</depend>
  <depend>rclcpp</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>xvfb</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
